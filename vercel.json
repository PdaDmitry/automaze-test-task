{
  "version": 2,
  "builds": [
    {
      "src": "projects/client/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "projects/client/dist/$1"
    }
  ],
  "installCommand": "npm install",
  "buildCommand": "cd projects/client && npm run build"
}
