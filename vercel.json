{
  "builds": [
    {
      "src": "projects/server/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "projects/client/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/projects/server/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/projects/client"
    }
  ]
}
